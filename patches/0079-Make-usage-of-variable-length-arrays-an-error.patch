 DEFAULTS += -Wnull-dereference
--- a/w3mimg/fb/Makefile.in
+++ b/w3mimg/fb/Makefile.in
@@ -11,6 +11,7 @@ DEFAULTS= -Wall
 DEFAULTS += -D_FORTIFY_SOURCE=2

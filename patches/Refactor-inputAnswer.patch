From: Rene Kita <mail@rkta.de>
Date: Wed Sep 11 13:34:11 CEST 2024
Subject: Refactor inputAnswer
Patch: patches/Refactor-inputAnswer.patch

---
 file.c    |   33 +++++++++++++++++++++------------
 istream.c |   23 +++++++++++------------
 proto.h   |    3 ++-
 3 files changed, 34 insertions(+), 25 deletions(-)

--- a/file.c
+++ b/file.c
@@ -859,8 +859,7 @@ readHeader(URLFile *uf, Buffer *newBuf,
 		    add_cookie(pu, name, value, expires, domain, path, flag,
 			       comment, version, port, commentURL);
 		if (err) {
-		    const char *ans = (accept_bad_cookie == ACCEPT_BAD_COOKIE_ACCEPT)
-			? "y" : NULL;
+		    int ans = (accept_bad_cookie == ACCEPT_BAD_COOKIE_ACCEPT);
 		    if (fmInitialized && (err & COO_OVERRIDE_OK) &&
 			accept_bad_cookie == ACCEPT_BAD_COOKIE_ASK) {
 			Str msg = Sprintf("Accept bad cookie from %s for %s?",
@@ -869,10 +868,9 @@ readHeader(URLFile *uf, Buffer *newBuf,
 					   ? domain->ptr : "<localdomain>"));
 			if (msg->length > COLS - 10)
 			    Strshrink(msg, msg->length - (COLS - 10));
-			Strcat_charp(msg, " (y/n)");
-			ans = inputAnswer(msg->ptr);
+			ans = confirm(msg);
 		    }
-		    if (ans == NULL || TOLOWER(*ans) != 'y' ||
+		    if (!ans ||
 			(err =
 			 add_cookie(pu, name, value, expires, domain, path,
 				    flag | COO_OVERRIDE, comment, version,
@@ -8757,24 +8755,22 @@ int
 checkOverWrite(const char *path)
 {
     struct stat st;
-    char *ans;
 
     if (stat(path, &st) < 0)
 	return 0;
-    ans = inputAnswer(_("File exists. Overwrite? (y/n)"));
-    if (ans && TOLOWER(*ans) == 'y')
+    if (confirm(Strnew_charp(_("File exists. Overwrite?"))))
 	return 0;
     else
 	return -1;
 }
 
-char *
-inputAnswer(const char *prompt)
+char
+confirm_multi(const char *prompt)
 {
     char *ans;
 
     if (QuietMessage)
-	return "n";
+	return 'n';
     if (fmInitialized) {
 	term_raw();
 	ans = inputChar(prompt);
@@ -8784,7 +8780,20 @@ inputAnswer(const char *prompt)
 	fflush(stdout);
 	ans = Strfgets(stdin)->ptr;
     }
-    return ans;
+    if (!ans || !*ans)
+	return '\0';
+    *ans = TOLOWER(*ans);
+    return *ans;
+}
+
+int
+confirm(Str prompt)
+{
+    char ans;
+
+    Strcat_charp(prompt, " (y/N)");
+    ans = confirm_multi(prompt->ptr);
+    return ans == 'y';
 }
 
 static void
--- a/istream.c
+++ b/istream.c
@@ -545,7 +545,7 @@ ssl_get_certificate(SSL * ssl, char *hos
     char buf[2048];
     Str amsg = NULL;
     Str emsg;
-    const char *ans;
+    int ans;
 
     if (ssl == NULL)
 	return NULL;
@@ -553,12 +553,11 @@ ssl_get_certificate(SSL * ssl, char *hos
     x = SSL_get_peer_certificate(ssl);
     if (x == NULL) {
 	if (accept_this_site(hostname, x))
-	    ans = "y";
+	    ans = 1;
 	else {
-	    emsg = Strnew_charp(_("No SSL peer certificate: accept? (y/n)"));
-	    ans = inputAnswer(emsg->ptr);
+	    ans = confirm(Strnew_charp(_("No SSL peer certificate: accept?")));
 	}
-	if (ans && TOLOWER(*ans) == 'y')
+	if (ans)
 	    amsg = Strnew_charp
 		(_("Accept SSL session without any peer certificate"));
 	else {
@@ -591,13 +590,13 @@ ssl_get_certificate(SSL * ssl, char *hos
 		    emsg = Sprintf("%s: accept? (y)es/(n)o/(a)lways)", em);
 		else
 		    emsg = Sprintf("%s: accept? (y/n)", em);
-		ans = inputAnswer(emsg->ptr);
-		if (ans && TOLOWER(*ans) == 'y') {
+		ans = confirm_multi(emsg->ptr);
+		if (ans == 'y') {
 		    /* FIXME: gettextize? */
 		    amsg = Sprintf("Accept unsecure SSL session: "
 				   "unverified: %s", em);
 		}
-		else if (ssl_known_hosts && ans && TOLOWER(*ans) == 'a') {
+		else if (ssl_known_hosts && ans == 'a') {
 		    amsg = Sprintf("Permanently accepted unverified SSL"
 				   "session: %s", em);
 		    perm = 1;
@@ -617,15 +616,15 @@ ssl_get_certificate(SSL * ssl, char *hos
     emsg = ssl_check_cert_ident(x, hostname);
     if (emsg != NULL) {
 	if (accept_this_site(hostname, x))
-	    ans = "y";
+	    ans = 1;
 	else {
 	    Str ep = Strdup(emsg);
 	    if (ep->length > COLS - 16)
 		Strshrink(ep, ep->length - (COLS - 16));
-	    Strcat_charp(ep, ": accept? (y/n)");
-	    ans = inputAnswer(ep->ptr);
+	    Strcat_charp(ep, ": accept?");
+	    ans = confirm(ep);
 	}
-	if (ans && TOLOWER(*ans) == 'y') {
+	if (ans) {
 	    amsg = Strnew_charp(_("Accept unsecure SSL session:"));
 	    Strcat(amsg, emsg);
 	}

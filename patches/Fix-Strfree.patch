As a wrapper around free(), Strfree() must accept NULL.
---
 Str.c |    1 +
 1 file changed, 1 insertion(+)

--- a/Str.c
+++ b/Str.c
@@ -146,6 +146,7 @@ Strclear(Str s)
 void
 Strfree(Str x)
 {
+    if (!x) return;
     GC_free(x->ptr);
     GC_free(x);
 }

Subject: Fix select menu setup
Patch: patches/Fix-select-menu-setup.patch

---
 menu.c |    5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

--- a/menu.c
+++ b/menu.c
@@ -1319,9 +1319,6 @@ popupMenu(int x, int y, Menu *menu)
 {
     set_menu_frame();
 
-    initSelectMenu();
-    initSelTabMenu();
-
     menu->cursorX = Currentbuf->cursorX + Currentbuf->rootX;
     menu->cursorY = Currentbuf->cursorY + Currentbuf->rootY;
     menu->x = x + FRAME_WIDTH + 1;
@@ -1369,6 +1366,7 @@ DEFUN(selMn, SELECT_MENU, "Pop up buffer
 	y = mouse_action.cursorY;
     }
 #endif
+    initSelectMenu();
     popupMenu(x, y, &SelectMenu);
 }
 
@@ -1588,6 +1586,7 @@ DEFUN(tabMn, TAB_MENU, "Pop up tab selec
 	y = mouse_action.cursorY;
     }
 #endif
+    initSelTabMenu();
     popupMenu(x, y, &SelTabMenu);
 }
 

From a798252247fb51a6f1788fa2c979975f7026edad Mon Sep 17 00:00:00 2001
From: Rene Kita <mail@rkta.de>
Date: Sun, 27 Nov 2022 08:07:43 +0100
Subject: [PATCH 124/172] Move OPTS to the end in all Makefiles

This allows overriding flags.
---
 libwc/Makefile.in      | 2 +-
 w3mimg/Makefile.in     | 2 +-
 w3mimg/fb/Makefile.in  | 2 +-
 w3mimg/win/Makefile.in | 2 +-
 w3mimg/x11/Makefile.in | 2 +-
 5 files changed, 5 insertions(+), 5 deletions(-)

--- a/libwc/Makefile.in
+++ b/libwc/Makefile.in
@@ -6,7 +6,7 @@ top_srcdir=@top_srcdir@
 VPATH=$(srcdir):.
 LIBRARY = libwc.a
 CC=@CC@
-CFLAGS = $(OPTS) -I.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @WCCFLAGS@ @DEFS@
+CFLAGS = -I.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @WCCFLAGS@ @DEFS@ $(OPTS)
 AR=ar
 RANLIB=@RANLIB@
 RM=rm
--- a/w3mimg/Makefile.in
+++ b/w3mimg/Makefile.in
@@ -6,7 +6,7 @@ SHELL=@SHELL@
 srcdir = @srcdir@
 top_srcdir = @top_srcdir@
 VPATH = $(srcdir):.
-CFLAGS=$(OPTS) -I.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
+CFLAGS= -I.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS) $(OPTS)
 AR=ar
 RANLIB=@RANLIB@
 RM=rm
--- a/w3mimg/fb/Makefile.in
+++ b/w3mimg/fb/Makefile.in
@@ -7,7 +7,7 @@ SHELL=@SHELL@
 srcdir = @srcdir@
 top_srcdir = @top_srcdir@
 VPATH = $(srcdir):.
-CFLAGS=$(OPTS) -I../.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
+CFLAGS= -I../.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS) $(OPTS)
 RM=rm
 
 IMGCFLAGS=@IMGFBCFLAGS@
--- a/w3mimg/win/Makefile.in
+++ b/w3mimg/win/Makefile.in
@@ -7,7 +7,7 @@ SHELL=@SHELL@
 srcdir = @srcdir@
 top_srcdir = @top_srcdir@
 VPATH = $(srcdir):.
-CFLAGS=$(OPTS) -I../.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
+CFLAGS= -I../.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS) $(OPTS)
 RM=rm
 CC=@CC@
 CXX=@CXX@
--- a/w3mimg/x11/Makefile.in
+++ b/w3mimg/x11/Makefile.in
@@ -7,7 +7,7 @@ SHELL=@SHELL@
 srcdir = @srcdir@
 top_srcdir = @top_srcdir@
 VPATH = $(srcdir):.
-CFLAGS=$(OPTS) -I../.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
+CFLAGS= -I../.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS) $(OPTS)
 RM=rm
 
 IMGCFLAGS=@IMGX11CFLAGS@

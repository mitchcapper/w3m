From: Rene Kita <mail@rkta.de>
Date: Tue Sep 17 11:52:48 CEST 2024
Subject: Use Strnulterm everywhere
Patch: patches/Use-Strnulterm-everywhere.patch

Use a macro to nul-terminated Str. Macro exists but is mostly unused.

While at it, refactor Strshrink.
---
 Str.c      |   39 ++++++++++++++++++++-------------------
 Str.h      |    2 +-
 file.c     |    2 +-
 indep.c    |    2 +-
 istream.c  |    2 +-
 mimehead.c |    2 +-
 6 files changed, 25 insertions(+), 24 deletions(-)

--- a/Str.c
+++ b/Str.c
@@ -35,9 +35,9 @@ Strnew(void)
     x->ptr = GC_MALLOC_ATOMIC(INITIAL_STR_SIZE);
     if (x->ptr == NULL)
 	exit(1);
-    x->ptr[0] = '\0';
     x->area_size = INITIAL_STR_SIZE;
     x->length = 0;
+    Strnulterm(x);
     return x;
 }
 
@@ -54,9 +54,9 @@ Strnew_size(int n)
     x->ptr = GC_MALLOC_ATOMIC(n + 1);
     if (x->ptr == NULL)
 	exit(1);
-    x->ptr[0] = '\0';
     x->area_size = n + 1;
     x->length = 0;
+    Strnulterm(x);
     return x;
 }
 
@@ -83,7 +83,7 @@ Strnew_charp(const char *p)
     x->area_size = n;
     x->length = len;
     memmove(x->ptr, p, len);
-    x->ptr[x->length] = '\0';
+    Strnulterm(x);
     return x;
 }
 
@@ -124,7 +124,7 @@ Strnew_charp_n(const char *p, int n)
     x->area_size = n + 1;
     x->length = len;
     memmove(x->ptr, p, len);
-    x->ptr[x->length] = '\0';
+    Strnulterm(x);
     return x;
 }
 
@@ -140,7 +140,7 @@ void
 Strclear(Str s)
 {
     s->length = 0;
-    s->ptr[0] = '\0';
+    Strnulterm(s);
 }
 
 void
@@ -170,7 +170,7 @@ Strcopy_charp(Str x, const char *y)
 
     if (y == NULL) {
 	x->length = 0;
-	x->ptr[0] = '\0';
+	Strnulterm(x);
 	return;
     }
     len = strlen(y);
@@ -183,8 +183,8 @@ Strcopy_charp(Str x, const char *y)
 	x->area_size = len + 1;
     }
     memmove(x->ptr, y, len);
-    x->ptr[len] = '\0';
     x->length = len;
+    Strnulterm(x);
 }
 
 void
@@ -194,7 +194,7 @@ Strcopy_charp_n(Str x, const char *y, in
 
     if (y == NULL) {
 	x->length = 0;
-	x->ptr[0] = '\0';
+	Strnulterm(x);
 	return;
     }
     if (len < 0 || len >= STR_SIZE_MAX)
@@ -206,8 +206,8 @@ Strcopy_charp_n(Str x, const char *y, in
 	x->area_size = len + 1;
     }
     memmove(x->ptr, y, len);
-    x->ptr[len] = '\0';
     x->length = len;
+    Strnulterm(x);
 }
 
 void
@@ -237,7 +237,7 @@ Strcat_charp_n(Str x, const char *y, int
     }
     memmove(&x->ptr[x->length], y, n);
     x->length += n;
-    x->ptr[x->length] = '\0';
+    Strnulterm(x);
 }
 
 void
@@ -289,7 +289,7 @@ Strgrow(Str x)
 	    exit(1);
 	x->area_size = newlen;
     }
-    x->ptr[x->length] = '\0';
+    Strnulterm(x);
 }
 
 Str
@@ -329,7 +329,7 @@ Strchop(Str s)
 	   (s->ptr[s->length - 1] == '\n' || s->ptr[s->length - 1] == '\r')) {
 	s->length--;
     }
-    s->ptr[s->length] = '\0';
+    Strnulterm(s);
 }
 
 void
@@ -344,7 +344,8 @@ Strinsert_char(Str s, int pos, char c)
 	return;
     for (i = s->length; i > pos; i--)
 	s->ptr[i] = s->ptr[i - 1];
-    s->ptr[++s->length] = '\0';
+    s->length++;
+    Strnulterm(s);
     s->ptr[pos] = c;
 }
 
@@ -364,14 +365,14 @@ Strdelete(Str s, int pos, int n)
     if (n < 0)
 	n = STR_SIZE_MAX - pos - 1;
     if (s->length <= pos + n) {
-	s->ptr[pos] = '\0';
 	s->length = pos;
+	Strnulterm(s);
 	return;
     }
     for (i = pos; i < s->length - n; i++)
 	s->ptr[i] = s->ptr[i + n];
-    s->ptr[i] = '\0';
     s->length = i;
+    Strnulterm(s);
 }
 
 void
@@ -379,8 +380,8 @@ Strtruncate(Str s, int pos)
 {
     if (pos < 0 || s->length < pos)
 	return;
-    s->ptr[pos] = '\0';
     s->length = pos;
+    Strnulterm(s);
 }
 
 void
@@ -388,11 +389,11 @@ Strshrink(Str s, int n)
 {
     if (n >= s->length) {
 	s->length = 0;
-	s->ptr[0] = '\0';
+	Strnulterm(s);
     }
     else if (n > 0) {
 	s->length -= n;
-	s->ptr[s->length] = '\0';
+	Strnulterm(s);
     }
 }
 
@@ -414,7 +415,7 @@ Strremovetrailingspaces(Str s)
 
     for (i = s->length - 1; i >= 0 && IS_SPACE(s->ptr[i]); i--) ;
     s->length = i + 1;
-    s->ptr[i + 1] = '\0';
+    Strnulterm(s);
 }
 
 Str
--- a/file.c
+++ b/file.c
@@ -4509,7 +4509,7 @@ getMetaRefreshParam(const char *q, Str *
 	        (s_tmp->ptr[s_tmp->length - 1] == '\"' ||	/* " */
 		 s_tmp->ptr[s_tmp->length - 1] == '\'')) {	/* ' */
 		s_tmp->length--;
-		s_tmp->ptr[s_tmp->length] = '\0';
+		Strnulterm(s_tmp);
 	    }
 	    q = r;
 	}
--- a/indep.c
+++ b/indep.c
@@ -724,7 +724,7 @@ growbuf_to_Str(struct growbuf *gb)
 
     if (gb->free_proc == &w3m_GC_free) {
 	growbuf_reserve(gb, gb->length + 1);
-	gb->ptr[gb->length] = '\0';
+	Strnulterm(gb);
 	s = New(struct _Str);
 	s->ptr = gb->ptr;
 	s->length = gb->length;
--- a/istream.c
+++ b/istream.c
@@ -268,7 +268,7 @@ ISgets_to_growbuf(InputStream stream, st
     }
 
     growbuf_reserve(gb, gb->length + 1);
-    gb->ptr[gb->length] = '\0';
+    Strnulterm(gb);
     return;
 }
 
--- a/mimehead.c
+++ b/mimehead.c
@@ -146,7 +146,7 @@ decodeU_to_growbuf(struct growbuf *gb, c
 	    i += 2;
 	}
     }
-    gb->ptr[gb->length] = '\0';
+    Strnulterm(gb);
     return;
 }
 
--- a/Str.h
+++ b/Str.h
@@ -68,7 +68,7 @@ void Strgrow(Str s);
 
 #define STR_SIZE_MAX (INT_MAX / 32)
 #define Strcat_char(x,y) (((x)->length+1>=STR_SIZE_MAX)?0:(((x)->length+1>=(x)->area_size)?Strgrow(x),0:0,(x)->ptr[(x)->length++]=(y),(x)->ptr[(x)->length]=0))
-#define Strnulterm(x) ((x)->ptr[(x)->length]=0)
+#define Strnulterm(x) ((x)->ptr[(x)->length]='\0')
 #define Strcmp(x,y)                  strcmp((x)->ptr,(y)->ptr)
 #define Strcmp_charp(x,y)            strcmp((x)->ptr,(y))
 #define Strcasecmp(x,y)              strcasecmp((x)->ptr,(y)->ptr)

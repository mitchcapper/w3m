From: Rene Kita <mail@rkta.de>
Date: Tue Sep 17 17:12:58 CEST 2024
Subject: Let Strfree take a NULL
Patch: patches/Let-Strfree-take-a-NULL.patch

---
 Str.c |    1 +
 1 file changed, 1 insertion(+)

--- a/Str.c
+++ b/Str.c
@@ -146,6 +146,7 @@ Strclear(Str s)
 void
 Strfree(Str x)
 {
+    if (!x) return;
     GC_free(x->ptr);
     GC_free(x);
 }

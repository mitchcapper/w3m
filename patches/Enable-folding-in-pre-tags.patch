From: Rene Kita <mail@rkta.de>
Subject: Enable folding in pre tags

Some bug trackers are really annoying to read, because they place
comments in <pre> elements. They usually provide some CSS to make it
readable.

As we do not talk CSS, add a command to reload the page folding those
long lines. This is a one-time operation. Additionally add an option to
make this behaviour permanent.
---
 file.c  |    6 ++++--
 fm.h    |    2 ++
 main.c  |    9 +++++++++
 proto.h |    1 +
 rc.c    |    3 +++
 5 files changed, 19 insertions(+), 2 deletions(-)

--- a/file.c
+++ b/file.c
@@ -2567,7 +2567,7 @@ check_breakpoint(struct readbuffer *obuf
     int tlen, len = obuf->line->length;
 
     append_tags(obuf);
-    if (pre_mode)
+    if (pre_mode && !FoldPre)
 	return;
     tlen = obuf->line->length - len;
     if (tlen > 0
@@ -6586,7 +6586,8 @@ HTMLlineproc0(char *line, struct html_fe
 			proc_mchar(obuf, 1, delta, &str, mode);
 		}
 		if (obuf->flag & (RB_SPECIAL & ~RB_PRE_INT))
-		    continue;
+		    if (!FoldPre)
+			continue;
 	    }
 	    else {
 		if (!IS_SPACE(*str))
@@ -6801,6 +6802,7 @@ loadHTMLBuffer(URLFile *f, Buffer *newBu
 	if (src)
 	    newBuf->sourcefile = tmp->ptr;
     }
+    FoldPre |= FoldPreOpt;
 
     loadHTMLstream(f, newBuf, src, newBuf->bufferprop & BP_FRAME);
 
--- a/fm.h
+++ b/fm.h
@@ -1041,6 +1041,8 @@ global int ignore_null_img_alt init(TRUE
 #define DISPLAY_INS_DEL_FONTIFY	2
 global int displayInsDel init(DISPLAY_INS_DEL_NORMAL);
 global int FoldTextarea init(FALSE);
+global int FoldPre init(FALSE);
+global int FoldPreOpt init(FALSE);
 global int FoldLine init(FALSE);
 #define DEFAULT_URL_EMPTY	0
 #define DEFAULT_URL_CURRENT	1
--- a/main.c
+++ b/main.c
@@ -4795,6 +4795,14 @@ DEFUN(vwSrc, SOURCE VIEW, "Toggle betwee
     displayBuffer(Currentbuf, B_NORMAL);
 }
 
+DEFUN(fold_pre, FOLD_PRE, "Fold long lines in <pre> elements")
+{
+    FoldPre = 1;
+    Currentbuf->need_reshape = TRUE;
+    displayBuffer(Currentbuf, B_FORCE_REDRAW);
+    FoldPre = FoldPreOpt;
+}
+
 /* reload */
 DEFUN(reload, RELOAD, "Load current document anew")
 {
@@ -4918,6 +4926,7 @@ DEFUN(reload, RELOAD, "Load current docu
 	restorePosition(Currentbuf, &sbuf);
     }
     displayBuffer(Currentbuf, B_FORCE_REDRAW);
+    FoldPre = FoldPreOpt;
 }
 
 /* reshape */
--- a/proto.h
+++ b/proto.h
@@ -96,6 +96,7 @@ extern void peekURL(void);
 extern void peekIMG(void);
 extern void curURL(void);
 extern void vwSrc(void);
+extern void fold_pre(void);
 extern void reload(void);
 extern void reshape(void);
 extern void chkURL(void);
--- a/rc.c
+++ b/rc.c
@@ -95,6 +95,7 @@ static int OptionEncode = FALSE;
 #define CMT_DISP_BORDERS N_("Display table borders, ignore value of BORDER")
 #define CMT_DISABLE_CENTER N_("Disable center alignment")
 #define CMT_FOLD_TEXTAREA N_("Fold lines in TEXTAREA")

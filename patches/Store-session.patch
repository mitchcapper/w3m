+/* Store session */
+DEFUN(savSession, SAVSESS, "Store session")
+{
+    Buffer *buf;
+    FILE *f;
+    TabBuffer *tab;
+    ParsedURL *url;
+    char *sep;
+
+    if (!(f = fopen(session_file, "w"))) goto fail;
+
+    sep = "";
+    for (tab = CurrentTab; tab->prevTab; tab = tab->prevTab);
+    for ( ; tab; tab = tab->nextTab) {
+	fputs(sep, f);
+	for (buf = tab->firstBuffer; buf; buf = buf->nextBuffer) {
+	    if ((url = baseURL(buf)))
+		fprintf(f, "%s\n", parsedURL2Str(url)->ptr);
+	    else
+		disp_err_message(buf->buffername, FALSE);
+	}
+	sep = "\n";
+    }
+
+    int r;
+    if ((r = fclose(f)) == EOF) goto fail;
+    return;
+
+fail:
+    disp_err_message(strerror(errno), FALSE);
+    return;
+}

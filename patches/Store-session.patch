+void
+_strSession(char *sf)
+{
+    Buffer *buf;
+    FILE *f;
+    TabBuffer *tab;
+    ParsedURL *url;
+    char *sep;
+
+    if (!sf)
+	sf = session_file ? session_file : rcFile(SESSION_FILE);
+    if (!(f = fopen(sf, "w"))) goto fail;
+
+    sep = "";
+    for (tab = CurrentTab; tab->prevTab; tab = tab->prevTab);
+    for ( ; tab; tab = tab->nextTab) {
+	fputs(sep, f);
+	for (buf = tab->firstBuffer; buf; buf = buf->nextBuffer) {
+	    if ((url = baseURL(buf)))
+		fprintf(f, "%s\n", parsedURL2Str(url)->ptr);
+	    /*
+	     * Needs refactoring of HistoryPage handling first.
+	    else if (!strcmp(buf->buffername, "HistoryPage"))
+		fprintf(f, "%s\n", buf->buffername);
+	    */
+	    else
+		disp_err_message(buf->buffername, FALSE);
+	}
+	sep = "\n";
+    }
+
+    int r;
+    if ((r = fclose(f)) == EOF) goto fail;
+    unlink_session = 0;
+    return;
+
+fail:
+    disp_err_message(strerror(errno), FALSE);
+    return;
+}
+
+/* Store session */
+DEFUN(strSession, STRSESS, "Store session")
+{
+    char *def, *sf;
+
+    def = session_file ? session_file : rcFile(SESSION_FILE);
+    sf = inputFilenameHist(Strnew_m_charp("Session file [",
+					  def,
+					  "]? ", NULL)->ptr,
+			   NULL, LoadHist);
+    if (!*sf)
+	sf = def;
+    _strSession(sf);
+    save_cookies();
+    saveUrlHistory();
+}

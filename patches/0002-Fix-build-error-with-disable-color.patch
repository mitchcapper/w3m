From 29f3d944fdb8d1bade8244b51ad627f4b81a1624 Mon Sep 17 00:00:00 2001
From: Rene Kita <mail@rkta.de>
Date: Wed, 13 Dec 2023 06:15:16 +0100
Subject: [PATCH 2/6] Fix build error with --disable-color

With --disable-color highIntensityColors is not declared.
---
 terms.c |    6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

--- a/terms.c
+++ b/terms.c
@@ -1677,8 +1677,12 @@ setfcolor(int color)
 static char *
 color_seq(int colmode)
 {
+    int n = 30;
     static char seqbuf[32];
-    sprintf(seqbuf, "\033[%dm", ((colmode >> 8) & 7) + (highIntensityColors ? 90 : 30));
+#ifdef USE_COLOR
+    n = highIntensityColors ? 90 : 30;
+#endif
+    sprintf(seqbuf, "\033[%dm", ((colmode >> 8) & 7) + n);
     return seqbuf;
 }
 

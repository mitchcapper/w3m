+static TextList *
+load_known_hosts(void)
+{
+    FILE *f;
+    Str l;
+    char *khf;
+    TextList *kh;
+
+    kh = newTextList();
+
+    khf = rcFile("known_hosts");
+
+    if (!(f = fopen(khf, "r")))
+	return NULL;
+
+    while (!feof(f)) {
+	l = Strfgets(f);
+	Strchop(l);
+	pushText(kh, l->ptr);
+    }
+    fclose(f);
+    return kh;
+}

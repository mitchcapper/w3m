+static int
+save_known_hosts(void)
+{
+    FILE *fp;
+    TextListItem *host;
+    char *khf, *tmpf;
+
+    tmpf = tmpfname(TMPF_DFL, NULL)->ptr;
+    khf = rcFile("known_hosts");
+    if (!(fp = fopen(tmpf, "w")))
+	return 1;
+
+    for (host = known_hosts->first; host; host = host->next)
+	fprintf(fp, "%s\n", host->ptr);
+
+    fclose(fp);
+    if (rename(tmpf, khf))
+	return 1;
+
+    return 0;
+}

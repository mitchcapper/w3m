+#define HINT_MOVE 0
+#define HINT_GOTO 1
+#define HINT_TAB 2
+#define HINT_MENU 3
+#define HINT_INVALID -1
+#define HINT_CANCEL -2
+
+static int
+selectLinkNum(char *input)
+{
+    HmarkerList *hl = Currentbuf->hmarklist;
+    char *endptr = '\0';
+    int link;
+
+    if (!hl || hl->nmark == 0)
+	return HINT_CANCEL;
+    if (input == NULL || *input == '\0')
+	return HINT_CANCEL;
+
+    if (displayLinkAlpha)
+	link = numberFromAlphaStr(Strnew_charp(input));
+    else
+	link = strtol(input, &endptr, 10);
+
+    if (link <= HINT_INVALID || link > hl->nmark - !!zeroBasedLinkNo)
+	return HINT_INVALID;
+    if (link == 0 && !zeroBasedLinkNo)
+	return HINT_INVALID;
+    if (link == 0 && !displayLinkAlpha && *endptr != '\0')
+	return HINT_INVALID;
+
+    return zeroBasedLinkNo ? link : link - 1;
+}
+
+static void
+gotoLinkNum(char *prompt, int operation)
+{
+    Anchor *an;
+    AnchorList *al = Currentbuf->href;
+    BufferPoint *po;
+    HmarkerList *hl;
+    char *url = NULL;
+    int prevLinks, prevMarks, link = HINT_INVALID;
+    int x, y, cursorX, cursorY, ySearch, yStart, yEnd, yDelta = 0;
+
+    if (al == NULL) {
+	al = Currentbuf->formitem;
+	if (al == NULL) {
+	    al = Currentbuf->img;
+	    if (al == NULL)
+		return;
+	}
+    }
+    /* get current position */
+    x = Currentbuf->currentColumn;
+    y = Currentbuf->currentLine->linenumber;
+    cursorX = Currentbuf->cursorX;
+    cursorY = Currentbuf->cursorY;
+    yStart = y;
+    yEnd = y;
+
+    an = closest_next_anchor(al, NULL, x, y);
+    if (an == NULL) {
+	an = closest_prev_anchor(al, NULL, x, y);
+	if (an == NULL) {
+	    an = retrieveAnchor(al, y, x);
+	    if (an == NULL)
+		return;
+	}
+    }
+
+    yStart = an->start.line;
+    url = an->url;
+    /* remember settings to revert */
+    prevLinks = displayLinkNumber;
+    prevMarks = MarkAllPages;
+
+    displayLinkNumber = TRUE;
+    MarkAllPages = FALSE;
+    Currentbuf->check_url = MarkAllPages;
+    reshape();
+
+    al = Currentbuf->href;
+    if (al == NULL) {
+	al = Currentbuf->formitem;
+	if (al == NULL) {
+	    al = Currentbuf->img;
+	    if (al == NULL)  {
+		displayLinkNumber = prevLinks;
+		MarkAllPages = prevMarks;
+		if (MarkAllPages)
+		    chkURLBuffer(Currentbuf); /* marks require reanchoring */
+		reshape();
+		disp_message_nsec(_("No hyperlinks found"), FALSE, 1, TRUE, FALSE);
+		return;
+	    }
+	}
+    }
+
+    cursorXY(Currentbuf, 0, 0);
+
+    /* get ending position */
+    ySearch = yStart - 1;
+    while(1) {
+	if (url == NULL)
+	    break;
+	an = closest_next_anchor(al, NULL, 0, ySearch);
+	if (an == NULL) {
+	    an = closest_prev_anchor(al, NULL, 0, yStart);
+	    break;
+	}
+	if (!strcmp(an->url, url))
+	    break;
+	ySearch++;
+    }
+
+    if (an != NULL)
+	yEnd = an->start.line;
+    yDelta = yEnd - yStart;
+
+    if (yDelta > 0)
+	nscroll(yDelta, B_SCROLL);
+
+    while(link == HINT_INVALID) {
+	link = selectLinkNum(inputStr(prompt, ""));
+	if (link == HINT_INVALID)
+	    disp_message_nsec(_("link invalid"), FALSE, 1, TRUE, FALSE);
+    }
+
+    if (yDelta > 0)
+	nscroll(-yDelta, B_SCROLL);
+
+    displayLinkNumber = prevLinks;
+    MarkAllPages = prevMarks;
+    if (MarkAllPages)
+	chkURLBuffer(Currentbuf); /* marks require reanchoring */
+    reshape();
+
+    cursorXY(Currentbuf, cursorX, cursorY);
+
+    if (link <= HINT_CANCEL)
+	return;
+
+    hl = Currentbuf->hmarklist;
+    if (!hl || hl->nmark == 0)
+	return;
+
+    po = hl->marks + link;
+    an = retrieveAnchor(Currentbuf->href, po->line, po->pos);
+    if (an == NULL) {
+	an = retrieveAnchor(Currentbuf->formitem, po->line, po->pos);
+	if (an == NULL) {
+	    an = retrieveAnchor(Currentbuf->img, po->line, po->pos);
+	    if (an == NULL)
+		 return;
+	}
+    }
+
+    gotoLine(Currentbuf, po->line);
+    Currentbuf->pos = po->pos;
+    arrangeCursor(Currentbuf);
+    if (operation == HINT_MOVE)
+	return;
+    else if (operation == HINT_GOTO)
+	followA();
+    else if (operation == HINT_TAB)
+	followTab(prec_num ? numTab(PREC_NUM) : NULL);
+    else if (operation == HINT_MENU)
+	mainMn();
+}
+
+DEFUN(movANum, MOVE_LINK_NUM, "Move cursor to input hyperlink")
+{
+    char *prompt;
+
+    prompt = "Move To Link: ";
+    gotoLinkNum(prompt, HINT_MOVE);
+}
+
+DEFUN(followANum, GOTO_LINK_NUM, "Follow the input hyperlink")
+{
+    char *prompt;
+
+    prompt = "Goto Link: ";
+    gotoLinkNum(prompt, HINT_GOTO);
+}
+
+DEFUN(tabANum, TAB_LINK_NUM, "Follow the input hyperlink in a new tab")
+{
+    char *prompt;
+
+    if (prec_num)
+	prompt = Sprintf("Tab %d Goto Link: ", prec_num)->ptr;
+    else
+	prompt = "Tab Goto Link: ";
+    gotoLinkNum(prompt, HINT_TAB);
+}
+
+DEFUN(menuANum, MENU_LINK_NUM, "Open menu on input hyperlink")
+{
+    char *prompt, *menu;
+
+    menu = CurrentCmdData;
+    if (menu != NULL && *menu != '\0')
+	prompt = Sprintf("Popup Menu '%s' On Link: ", menu)->ptr;
+    else
+	prompt = "Popup Menu On Link: ";
+    gotoLinkNum(prompt, HINT_MENU);
+}

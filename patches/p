+const char alpha_lower_keymap[] = "abcdefghijklmnopqrstuvwxyz";
+
+#define ALPHA_MAP_SIZE sizeof(alpha_lower_keymap)
+#define ALPHA_KEY_SIZE 4
+
+int
+numberFromAlphaStr(Str str)
+{
+    int key, result = 0;
+    int invalid = -1;
+    int a = ALPHA_MAP_SIZE - 1;
+    int pow[6] = {0, 1, a, a * a, a * a * a, a * a * a * a};
+    int pow_size = sizeof(pow) / sizeof(pow[0]);
+
+    key = str->length;
+
+    if (key < 1 || key > ALPHA_KEY_SIZE)
+	return invalid;
+    if (str->ptr[0] == alpha_lower_keymap[0] && !zeroBasedLinkNo)
+	return invalid;
+
+    for (int i = 0; i < key; i++)
+	    result += (strchr(alpha_lower_keymap, str->ptr[i]) -
+		    alpha_lower_keymap) * pow[key - i];
+
+    if (result > pow[pow_size - 1] - 1)
+	return invalid;
+    return result;
+}
+
+static Str
+alphaStrFromInt(int n)
+{
+    char c;
+    int max, a = ALPHA_MAP_SIZE - 1;
+    int pow[6] = {0, 1, a, a * a, a * a * a, a * a * a * a};
+    int pow_size = sizeof(pow) / sizeof(pow[0]);
+    Str str;
+
+    if (n == 0 && zeroBasedLinkNo)
+	return Sprintf("%c", alpha_lower_keymap[n]);
+    if (n <= 0 || n >= pow[pow_size - 1])
+	return NULL;
+
+    str = Strnew();
+
+    for (int i = 1; i < pow_size; i++) {
+	max = pow_size - i;
+	if (n < pow[max])
+	    continue;
+	c = alpha_lower_keymap[n / (pow[max] * 1)];
+	Strcat_char(str, c);
+	break;
+    }
+
+    while(1) {
+	if (max <= 1)
+	    break;
+	else if (max == 2)
+	    c = alpha_lower_keymap[n % pow[max]];
+	else
+	    c = alpha_lower_keymap[n % pow[max] / pow[max - 1]];
+	Strcat_char(str, c);
+	max--;
+    }
+
+    return str;
+}
+
 Str
 getLinkNumberStr(int correction)
 {
-    return Sprintf("[%d]", cur_hseq + correction - !!zeroBasedLinkNo);
+    Str str;
+
+    if (!displayLinkAlpha)
+	return Sprintf("[%d]", cur_hseq + correction - !!zeroBasedLinkNo);
+    str = alphaStrFromInt(cur_hseq + correction - !!zeroBasedLinkNo);
+    return Sprintf("[%s]", str ? str->ptr : "?");
 }
 

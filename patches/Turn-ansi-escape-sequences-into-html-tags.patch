From 57055959d1ea73f1d77bca627c2fd5f43f9743d7 Mon Sep 17 00:00:00 2001
From: Alberto Fanjul <albertofanjul@gmail.com>
Date: Mon, 6 Jun 2022 07:32:45 +0200
Subject: [PATCH] Turn ansi escape sequences into html tags

---
 scripts/w3mman/w3mman2html.cgi.in | 9 +++++++++
 1 file changed, 9 insertions(+)

--- a/scripts/w3mman/w3mman2html.cgi.in
+++ b/scripts/w3mman/w3mman2html.cgi.in
@@ -162,6 +162,15 @@ EOF
     next;
   }
 
+  my $printchar='[^]';
+  s@\[1m($printchar+)\[0m@<b>$1</b>@g;
+  s@\[4m($printchar+)\[24m@<u>$1</u>@g;
+  s@\[1m($printchar+)\[0m@<b>$1</b>@g;
+  s@\[1m($printchar+)\[22m@<b>$1</b>@g;
+  s@\[1m($printchar+)\[4m@<b>$1</b>@g;
+  s@\[22m($printchar+)\[0m@<u>$1</u>@g;
+  s@\[22m($printchar+)\[24m@<u>$1</u>@g;
+  s@\[4m($printchar+)\[0m@<u>$1</u>@g;
   s@(http|ftp)://[\w.\-/~]+[\w/]@<a href="$&">$&</a>@g;
   s@\b(mailto:|)(\w[\w.\-]*\@\w[\w.\-]*\.[\w.\-]*\w)@<a href="mailto:$2">$1$2</a>@g;
   s@(\W)(\~?/[\w.][\w.\-/~]*)@$1 . &file_ref($2)@ge;

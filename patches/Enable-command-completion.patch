+++ b/linein.c
@@ -45,6 +45,7 @@ static int getcntrl(void);
 static int terminated(unsigned char c);
 #define iself ((void(*)(void))insertself)
 
+static void cmd_compl(void);
 static void next_compl(int next);
 static void next_dcompl(int next);
 static Str doComplete(Str ifn, int *status, int next);
@@ -54,7 +55,7 @@ void (*InputKeymap[32]) (void) = {
 /*  C-@     C-a     C-b     C-c     C-d     C-e     C-f     C-g     */
     _compl, _mvB,   _mvL,   _inbrk, delC,   _mvE,   _mvR,   _inbrk,
 /*  C-h     C-i     C-j     C-k     C-l     C-m     C-n     C-o     */
-    _bs,    iself,  _enter, killn,  iself,  _enter, _next,  _editor,
+    _bs,    _compl, _enter, killn,  iself,  _enter, _next,  _editor,
 /*  C-p     C-q     C-r     C-s     C-t     C-u     C-v     C-w     */
     _prev,  _quo,   _bsw,   iself,  _mvLw,  killb,  _quo,   _bsw,
 /*  C-x     C-y     C-z     C-[     C-\     C-]     C-^     C-_     */
@@ -113,6 +114,8 @@ inputLineHistSearch(const char *prompt,
 	is_passwd = TRUE;
 	move_word = FALSE;
     }
+    else if (flag & IN_EXECCMD)
+	cm_mode = CPL_CMD;
     else if (flag & IN_COMMAND)
 	cm_mode = CPL_ON;
     else
@@ -633,6 +636,8 @@ _inbrk(void)
 static void
 _compl(void)
 {
+    if (cm_mode & CPL_CMD)
+	cmd_compl();
     next_compl(1);
 }
 
@@ -652,6 +657,33 @@ _tcompl(void)
 }
 
 static void
+cmd_compl(void)
+{
+    FuncList *fl;
+    char *p;
+    int n;
+
+    for (p = strBuf->ptr + strBuf->length; p != strBuf->ptr; p--) {
+	if (*p == ';' || IS_SPACE(*p)) {
+	    p++;
+	    break;
+	}
+    }
+
+    n = strlen(p);
+
+    for (fl = w3mFuncList; fl->id; fl++)
+	if (!strncmp(fl->id, p, n))
+	    break;
+
+    if (!fl->id)
+	return;
+
+    CBeforeBuf = Strsubstr(strBuf, 0, p - strBuf->ptr + 1);
+    strBuf = Strnew_m_charp(p, fl->id, NULL);
+}
+
+static void
 next_compl(int next)
 {
     int status;

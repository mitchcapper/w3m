From: Rene Kita <mail@rkta.de>
Date: Sun Jan 21 11:01:10 CET 2024
Subject: Enable command completion
Patch: patches/Enable-command-completion.patch

This patch enables completion of commands and adds a separate history
for commands only.
---
 fm.h     |    3 +++
 linein.c |   34 +++++++++++++++++++++++++++++++++-
 main.c   |    4 +++-
 3 files changed, 39 insertions(+), 2 deletions(-)

--- a/fm.h
+++ b/fm.h
@@ -243,6 +243,7 @@ extern int REV_LB[];
 #define CPL_ON		0x2
 #define CPL_ALWAYS	0x4
 #define CPL_URL		0x8
+#define CPL_CMD		0x10	/* Completion for commands in w3mFuncList */
 
 /* Flags for inputLine() */
 #define IN_STRING	0x10
@@ -251,6 +252,7 @@ extern int REV_LB[];
 #define IN_COMMAND	0x80
 #define IN_URL		0x100
 #define IN_CHAR		0x200
+#define IN_EXECCMD	0x400	/* Coming from execCmd, COMMAND */
 
 #define IMG_FLAG_SKIP	1
 #define IMG_FLAG_AUTO	2
@@ -284,6 +286,7 @@ extern int REV_LB[];
 
 #define inputLineHist(p,d,f,h)	inputLineHistSearch(p,d,f,h,NULL)
 #define inputLine(p,d,f)	inputLineHist(p,d,f,NULL)
+#define inputCmdHist(p,d,h)	inputLineHist(p,d,IN_EXECCMD,h)
 #define inputStr(p,d)		inputLine(p,d,IN_STRING)
 #define inputStrHist(p,d,h)	inputLineHist(p,d,IN_STRING,h)
 #define inputFilename(p,d)	inputLine(p,d,IN_FILENAME)

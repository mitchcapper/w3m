From: Rene Kita <mail@rkta.de>
Date: Thu Feb 13 08:12:50 CET 2025

Use pkg-config first to detect linker flags before falling back to the
old manual approach. This should help when cross-compiling while
hopefully not breaking anything.
---
 Makefile.in  |    2 +-
 acinclude.m4 |   17 ++++++++++++-----
 2 files changed, 13 insertions(+), 6 deletions(-)

--- a/acinclude.m4
+++ b/acinclude.m4
@@ -408,6 +408,7 @@ AC_DEFUN([AC_W3M_W3MMAILER],
 # ----------------------------------------------------------------
 AC_DEFUN([AC_W3M_EXTLIBS],
 [lib=$1
+ PKG_CHECK_MODULES(EXT, $lib,,[
  AC_MSG_CHECKING(for -l$lib)
  extlib="not found"
  for dir in /lib /usr/lib /usr/local/lib /usr/ucblib /usr/ccslib /usr/ccs/lib /lib64 /usr/lib64
@@ -418,7 +419,9 @@ AC_DEFUN([AC_W3M_EXTLIBS],
     break
    fi
  done
- AC_MSG_RESULT($extlib)])
+ AC_MSG_RESULT($extlib)
+ ])
+])
 #
 # ----------------------------------------------------------------
 # AC_W3M_TERMLIB
@@ -442,12 +445,14 @@ AC_ARG_WITH(termlib,
 # ----------------------------------------------------------------
 AC_DEFUN([AC_W3M_GC],
 [AC_MSG_CHECKING(GC library exists)
-AC_SUBST(LIBGC)
+AC_SUBST(GC_LIBS)
 AC_ARG_WITH(gc,
  [  --with-gc[[=PREFIX]]      GC library/header location [[guessed]]],
  [test x"$with_gc" = xno && AC_MSG_ERROR([You can not build w3m without GC])],
  [with_gc="yes"])
  AC_MSG_RESULT($with_gc)
+if test x"$with_gc" != xno; then
+  PKG_CHECK_MODULES(GC, bdw-gc,,[
  test x"$with_gc" = xyes && with_gc="/usr /usr/local ${HOME}"
  unset ac_cv_header_gc_h
  AC_CHECK_HEADER(gc.h)
@@ -473,7 +478,7 @@ AC_ARG_WITH(gc,
    fi
  fi
  unset ac_cv_lib_gc_GC_init
- AC_CHECK_LIB(gc, GC_init, [LIBGC="-lgc"])
+ AC_CHECK_LIB(gc, GC_init, [GC_LIBS="-lgc"])
  if test x"$ac_cv_lib_gc_GC_init" = xno; then
     AC_MSG_CHECKING(GC library location)
     AC_MSG_RESULT($with_gc)
@@ -483,13 +488,15 @@ AC_ARG_WITH(gc,
       LDFLAGS="$LDFLAGS -L$dir/lib"
       AC_MSG_CHECKING($dir)
       unset ac_cv_lib_gc_GC_init
-      AC_CHECK_LIB(gc, GC_init, [gclibdir="$dir/lib"; LIBGC="-L$dir/lib -lgc"; break])
+      AC_CHECK_LIB(gc, GC_init, [gclibdir="$dir/lib"; GC_LIBS="-L$dir/lib -lgc"; break])
       LDFLAGS="$ldflags"
     done
     if test x"$gclibdir" = xno; then
       AC_MSG_ERROR([libgc not found])
     fi
- fi])
+ fi
+ ])
+fi])
 #
 # ----------------------------------------------------------------
 # AC_W3M_SSL_DIGEST_AUTH
--- a/Makefile.in
+++ b/Makefile.in
@@ -69,7 +69,7 @@ DEFS = @DEFS@ -DAUXBIN_DIR=\"$(AUXBIN_DI
         -DLOCALEDIR=\"$(localedir)\"
 LDFLAGS = @LDFLAGS@
 LIBS = @LIBS@
-GC_LIBS = @LIBGC@
+GC_LIBS = @GC_LIBS@
 EXT_LIBS = -L. -lindep @LIBINTL@ $(GC_LIBS)
 W3M_LIBS = @W3M_LIBS@
 WCTARGET = @WCTARGET@

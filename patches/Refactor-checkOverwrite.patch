From: Rene Kita <mail@rkta.de>
Date: Wed Sep 11 14:07:43 CEST 2024
Subject: Refactor checkOverwrite
Patch: patches/Refactor-checkOverwrite.patch

---
 file.c |   15 +++++++--------
 main.c |    2 +-
 2 files changed, 8 insertions(+), 9 deletions(-)

--- a/file.c
+++ b/file.c
@@ -8537,7 +8537,7 @@ _doFileCopy(char *tmpf, char *defstr, in
 		p = conv_to_system(p);
 	    }
 	    p = expandPath(p);
-	    if (checkOverWrite(p) < 0)
+	    if (!checkOverWrite(p))
 		return -1;
 	}
 	if (checkCopyFile(tmpf, p) < 0) {
@@ -8594,7 +8594,7 @@ _doFileCopy(char *tmpf, char *defstr, in
 	    is_pipe = TRUE;
 	else {
 	    p = expandPath(p);
-	    if (checkOverWrite(p) < 0)
+	    if (!checkOverWrite(p))
 		return -1;
 	}
 	if (checkCopyFile(tmpf, p) < 0) {
@@ -8642,7 +8642,7 @@ doFileSave(URLFile uf, const char *defst
 		return -1;
 	    p = conv_to_system(p);
 	}
-	if (checkOverWrite(p) < 0)
+	if (!checkOverWrite(p))
 	    return -1;
 	if (checkSaveFile(uf.stream, p) < 0) {
 	    msg = Sprintf(_("Can't save. Load file and %s are identical."),
@@ -8691,7 +8691,7 @@ doFileSave(URLFile uf, const char *defst
 	if (*q == '\0')
 	    return -1;
 	p = expandPath(q);
-	if (checkOverWrite(p) < 0)
+	if (!checkOverWrite(p))
 	    return -1;
 	if (checkSaveFile(uf.stream, p) < 0) {
 	    printf(_("Can't save. Load file and %s are identical."), p);
@@ -8743,15 +8743,14 @@ int
 checkOverWrite(const char *path)
 {
     struct stat st;
-    char *ans;
 
     if (stat(path, &st) < 0)
-	return 0;
+	return -1;
     ans = inputAnswer(_("File exists. Overwrite? (y/n)"));
     if (ans && TOLOWER(*ans) == 'y')
-	return 0;
+	return 1;
     else
-	return -1;
+	return 0;
 }
 
 char *
--- a/main.c
+++ b/main.c
@@ -4837,7 +4837,7 @@ DEFUN(svBuf, PRINT SAVE_SCREEN, "Save re
 	    file = conv_to_system(file);
 	}
 	file = expandPath(file);
-	if (checkOverWrite(file) < 0) {
+	if (!checkOverWrite(file)) {
 	    displayBuffer(Currentbuf, B_NORMAL);
 	    return;
 	}

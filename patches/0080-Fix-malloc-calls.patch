From 500e054aeb3fc860728eddbb731a818884107473 Mon Sep 17 00:00:00 2001
From: Rene Kita <mail@rkta.de>
Date: Thu, 6 Jan 2022 11:35:37 +0100
Subject: [PATCH 080/172] Fix malloc calls

---
 table.c |   20 ++++++++++++--------
 1 file changed, 12 insertions(+), 8 deletions(-)

--- a/table.c
+++ b/table.c
@@ -1254,10 +1254,12 @@ check_table_width(struct table *t, doubl
     int i, j, k, m, bcol, ecol;
     int corr = 0;
     struct table_cell *cell = &t->cell;
-    short *orgwidth = GC_malloc(t->maxcol >= 0 ? t->maxcol + 1 : 1);
-    short *corwidth = GC_malloc(t->maxcol >= 0 ? t->maxcol + 1 : 1);
-    short *cwidth = GC_malloc(cell->maxcell >= 0 ? cell->maxcell + 1 : 1);
-    double *swidth = GC_malloc(cell->maxcell >= 0 ? cell->maxcell + 1 : 1);
+    int maxcol = t->maxcol >= 0 ? t->maxcol + 1 : 1;
+    int maxcell = cell->maxcell >= 0 ? cell->maxcell + 1 : 1;
+    short *orgwidth = GC_malloc(maxcol * sizeof(*orgwidth));
+    short *corwidth = GC_malloc(maxcol * sizeof(*corwidth));
+    short *cwidth = GC_malloc(maxcell * sizeof(*cwidth));
+    double *swidth = GC_malloc(maxcell * sizeof(*swidth));
     double twidth, sxy, *Sxx, stotal;
 
     twidth = 0.;
@@ -1602,7 +1604,8 @@ check_table_height(struct table *t)
 static int
 get_table_width(struct table *t, short *orgwidth, short *cellwidth, int flag)
 {
-    short *newwidth = GC_malloc(t->maxcol >= 0 ? t->maxcol + 1 : 1);
+    int maxcol = t->maxcol >= 0 ? t->maxcol + 1 : 1;
+    short *newwidth = GC_malloc(maxcol * sizeof(*newwidth));
     int i;
     int swidth;
     struct table_cell *cell = &t->cell;
@@ -1612,7 +1615,8 @@ get_table_width(struct table *t, short *
 	newwidth[i] = max(orgwidth[i], 0);
 
     if (flag & CHECK_FIXED) {
-	short *ccellwidth = GC_malloc(cell->maxcell >= 0 ? cell->maxcell + 1 : 1);
+	int maxcell = cell->maxcell >= 0 ? cell->maxcell + 1 : 1;
+	short *ccellwidth = GC_malloc(maxcell * sizeof(*ccellwidth));
 	for (i = 0; i <= t->maxcol; i++) {
 	    if (newwidth[i] < t->fixed_width[i])
 		newwidth[i] = t->fixed_width[i];
@@ -3484,8 +3488,8 @@ set_table_matrix0(struct table *t, int m
     int i, j, k, bcol, ecol;
     int width;
     double w0, w1, w, s, b;
-    double *we = GC_malloc(size);
-    char *expand = GC_malloc(size);
+    double *we = GC_malloc(size * sizeof(*we));
+    char *expand = GC_malloc(size * sizeof(*expand));
     struct table_cell *cell = &t->cell;
 
     w0 = 0.;

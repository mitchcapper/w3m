From 7a9863b60efc3bd2972dfc87fea5c531ee5e9ae9 Mon Sep 17 00:00:00 2001
From: Rene Kita <mail@rkta.de>
Date: Sun, 26 Dec 2021 11:54:19 +0100
Subject: [PATCH 004/172] Add OpenBSD build job

---
 .builds/openbsd.yml | 45 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)
 create mode 100644 .builds/openbsd.yml

diff --git a/.builds/openbsd.yml b/.builds/openbsd.yml
new file mode 100644
index 00000000..cd70bc1d
--- /dev/null
+++ b/.builds/openbsd.yml
@@ -0,0 +1,45 @@
+image: openbsd/latest
+sources:
+  - https://git.sr.ht/~rkta/w3m
+packages:
+  - boehm-gc
+  - gettext-tools
+triggers:
+  - action: email
+    condition: failure
+    to: mail@rkta.de
+tasks:
+  - everything: |
+      cd w3m
+      make distclean || :
+      ./configure \
+      --with-x --enable-m17n --enable-unicode --enable-japanese --enable-nls \
+      --enable-color --enable-ansi_color  --enable-bgcolor --enable-image \
+      --enable-xface --enable-keymap=w3m  --enable-menu --enable-mouse \
+      --enable-history --enable-alarm  --enable-cookie --enable-nntp \
+      --enable-gopher --enable-dict  --enable-help_cgi \
+      --enable-external_uri_loader --enable-w3mmailer  --with-migemo \
+      --with-editor --with-mailer --with-browser  --enable-ipv6 --with-ssl \
+      --enable-sslverify --enable-digest_auth  --with-termlib --with-gc
+      make -j4 OPTS='-Werror -Wno-invalid-source-encoding'
+      cd tests
+      sh run_tests
+  - debian: |
+      cd w3m
+      make distclean || :
+      ./configure \
+        --enable-m17n --enable-image --enable-color --enable-ansi_color \
+        --enable-mouse --enable-menu --enable-cookie --with-ssl \
+        --enable-sslverify --enable-external_uri_loader --enable-w3mmailer \
+        --enable-nntp --enable-gopher --enable-ipv6 --enable-alarm \
+        --with-migemo
+      make -j4 OPTS='-Werror -Wno-invalid-source-encoding'
+      cd tests
+      sh run_tests
+  - default: |
+      cd w3m
+      make distclean || :
+      ./configure
+      make -j4 OPTS='-Werror -Wno-invalid-source-encoding'
+      cd tests
+      sh run_tests
-- 
2.30.2


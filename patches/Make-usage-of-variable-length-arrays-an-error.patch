From 6663dcc98fa8beb944b492cb46dde8b48c82f062 Mon Sep 17 00:00:00 2001
From: Rene Kita <mail@rkta.de>
Date: Sun, 26 Dec 2021 17:44:57 +0100
Subject: Make usage of variable length arrays an error

The previous patch removed the last and only usage of VLAs in the code
base. Since C11 variable length arrays are optional and we are already
using a garbage collector. Prevent the usage of VLAs by making in an
error.
---
 Makefile.in            |    1 +
 libwc/Makefile.in      |    4 +++-
 w3mimg/Makefile.in     |    4 +++-
 w3mimg/fb/Makefile.in  |    4 +++-
 w3mimg/win/Makefile.in |    4 +++-
 w3mimg/x11/Makefile.in |    4 +++-
 6 files changed, 16 insertions(+), 5 deletions(-)

--- a/Makefile.in
+++ b/Makefile.in
@@ -36,6 +36,7 @@ ETC_DIR = $(sysconfdir)
 CONF_DIR = $(sysconfdir)/$(PACKAGE)
 
 WARNINGS  = -Wall
+WARNINGS += -Werror=vla
 WARNINGS += -Wnull-dereference
 WARNINGS += -Wimplicit-function-declaration
 WARNINGS += -Wimplicit-int
--- a/libwc/Makefile.in
+++ b/libwc/Makefile.in
@@ -6,7 +6,9 @@ top_srcdir=@top_srcdir@
 VPATH=$(srcdir):.
 LIBRARY = libwc.a
 CC=@CC@
-CFLAGS = $(OPTS) -I.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @WCCFLAGS@ @DEFS@
+WARNINGS  = -Wall
+WARNINGS += -Werror=vla
+CFLAGS = $(WARNINGS) $(OPTS) -I.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @WCCFLAGS@ @DEFS@
 AR=ar
 RANLIB=@RANLIB@
 RM=rm
--- a/w3mimg/fb/Makefile.in
+++ b/w3mimg/fb/Makefile.in
@@ -7,7 +7,9 @@ SHELL=@SHELL@
 srcdir = @srcdir@
 top_srcdir = @top_srcdir@
 VPATH = $(srcdir):.
-CFLAGS=$(OPTS) -I../.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
+WARNINGS  = -Wall
+WARNINGS += -Werror=vla
+CFLAGS=$(WARNINGS) $(OPTS) -I../.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
 RM=rm
 
 IMGCFLAGS=@IMGFBCFLAGS@
--- a/w3mimg/win/Makefile.in
+++ b/w3mimg/win/Makefile.in
@@ -7,7 +7,9 @@ SHELL=@SHELL@
 srcdir = @srcdir@
 top_srcdir = @top_srcdir@
 VPATH = $(srcdir):.
-CFLAGS=$(OPTS) -I../.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
+WARNINGS  = -Wall
+WARNINGS += -Werror=vla
+CFLAGS=$(WARNINGS) $(OPTS) -I../.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
 RM=rm
 CC=@CC@
 CXX=@CXX@
--- a/w3mimg/x11/Makefile.in
+++ b/w3mimg/x11/Makefile.in
@@ -7,7 +7,9 @@ SHELL=@SHELL@
 srcdir = @srcdir@
 top_srcdir = @top_srcdir@
 VPATH = $(srcdir):.
-CFLAGS=$(OPTS) -I../.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
+WARNINGS  = -Wall
+WARNINGS += -Werror=vla
+CFLAGS=$(WARNINGS) $(OPTS) -I../.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
 RM=rm
 
 IMGCFLAGS=@IMGX11CFLAGS@
--- a/w3mimg/Makefile.in
+++ b/w3mimg/Makefile.in
@@ -6,7 +6,9 @@ SHELL=@SHELL@
 srcdir = @srcdir@
 top_srcdir = @top_srcdir@
 VPATH = $(srcdir):.
-CFLAGS=$(OPTS) -I.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
+WARNINGS  = -Wall
+WARNINGS += -Werror=vla
+CFLAGS=$(WARNINGS) $(OPTS) -I.. -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
 AR=ar
 RANLIB=@RANLIB@
 RM=rm

Subject: Refactor Strshrink
Patch: patches/Refactor-Strshrink.patch

---
 Str.c |   10 ++--------
 1 file changed, 2 insertions(+), 8 deletions(-)

--- a/Str.c
+++ b/Str.c
@@ -388,14 +388,8 @@ Strtruncate(Str s, int pos)
 void
 Strshrink(Str s, int n)
 {
-    if (n >= s->length) {
-	s->length = 0;
-	Strnulterm(s);
-    }
-    else if (n > 0) {
-	s->length -= n;
-	Strnulterm(s);
-    }
+    s->length = (n >= s->length) ? 0 : (s->length - n);
+    Strnulterm(s);
 }
 
 void

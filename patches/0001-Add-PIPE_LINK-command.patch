+int
+save2tmp(URLFile uf, char *tmpf)
+{
+    FILE *ff;
+    int r;
+
+    ff = fopen(tmpf, "wb");
+    if (ff == NULL) {
+	/* fclose(f); */
+	return -1;
+    }
+    r = save2file(uf, ff);
+    fclose(ff);
+    return r;
+}

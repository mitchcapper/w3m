Only set on initialization and only read once.
---
 cookie.c |    3 +--
 cookie.h |    1 -
 2 files changed, 1 insertion(+), 3 deletions(-)

--- a/cookie.c
+++ b/cookie.c
@@ -376,8 +376,7 @@ add_cookie(ParsedURL *pu, Str name, Str
     if (!p) {
 	p = New(struct cookie);
 	p->flag = 0;

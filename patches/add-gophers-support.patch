 3 files changed, 21 insertions(+), 8 deletions(-)

--- a/file.c
+++ b/file.c
@@ -1954,7 +1954,7 @@ loadGeneralFile(char *path, ParsedURL *v
     }
 #endif				/* USE_NNTP */
 #ifdef USE_GOPHER
-    else if (pu.scheme == SCM_GOPHER) {
+    else if (pu.scheme == SCM_GOPHER || pu.scheme == SCM_GOPHERS) {
 	p = pu.file;
 	while(*p == '/')
 	    ++p;
@@ -2287,7 +2287,7 @@ fail:
 		return NULL;
 	    file = guess_filename(pu.file);
 #ifdef USE_GOPHER
-	    if (f.scheme == SCM_GOPHER)
+	    if (f.scheme == SCM_GOPHER || f.scheme == SCM_GOPHERS)
 		file = Sprintf("%s.html", file)->ptr;
 #endif
 #ifdef USE_NNTP
--- a/url.c
+++ b/url.c
@@ -75,12 +75,14 @@ static int
 #ifdef USE_SSL
     443,			/* https */
 #endif				/* USE_SSL */
-    1965			/* gemini */
+    1965,			/* gemini */
+    70				/* gophers */
 };
 
 struct cmdtable schemetable[] = {
     {"http", SCM_HTTP},
     {"gopher", SCM_GOPHER},
+    {"gophers", SCM_GOPHERS},
     {"ftp", SCM_FTP},
     {"local", SCM_LOCAL},
     {"file", SCM_LOCAL},
@@ -97,6 +99,7 @@ struct cmdtable schemetable[] = {
     {"https", SCM_HTTPS},
 #endif				/* USE_SSL */
     {"gemini", SCM_GEMINI},
+    {"gophers", SCM_GOPHERS},
     {NULL, SCM_UNKNOWN},
 };
 
@@ -231,6 +234,7 @@ DefaultFile(int scheme)
 	return allocStr(HTTP_DEFAULT_FILE, -1);
 #ifdef USE_GOPHER
     case SCM_GOPHER:
+    case SCM_GOPHERS:
 	return allocStr("1", -1);
 #endif				/* USE_GOPHER */
     case SCM_LOCAL:
@@ -966,7 +970,8 @@ parseURL(char *url, ParsedURL *p_url, Pa
 
     q = p;

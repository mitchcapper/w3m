-    if (p_url->scheme == SCM_GOPHER) {
+    if (p_url->scheme == SCM_GOPHER
+	|| p_url->scheme == SCM_GOPHERS) {
 	if (*q == '/')
 	    q++;
 	if (*q && q[0] != '/' && q[1] != '/' && q[2] == '/')
@@ -980,7 +985,8 @@ parseURL(char *url, ParsedURL *p_url, Pa
 	goto do_query;
     }
 #ifdef USE_GOPHER
-    if (p_url->scheme == SCM_GOPHER && *p == 'R') {
+    if ((p_url->scheme == SCM_GOPHER
+	 || p_url->scheme == SCM_GOPHERS)&& *p == 'R') {
 	if (!*++p) {
 	    p_url->file = "";
 	    goto do_query;
@@ -1149,7 +1155,8 @@ parseURL2(char *url, ParsedURL *pu, Pars
 #endif
 		if (
 #ifdef USE_GOPHER
-		       pu->scheme != SCM_GOPHER &&
+		       (pu->scheme != SCM_GOPHER
+			&& pu->scheme != SCM_GOPHERS) &&
 #endif				/* USE_GOPHER */
 		       pu->file[0] != '/'
 #ifdef SUPPORT_DOS_DRIVE_PREFIX
@@ -1172,7 +1179,8 @@ parseURL2(char *url, ParsedURL *pu, Pars
 		}
 	    }
 #ifdef USE_GOPHER
-	    else if (pu->scheme == SCM_GOPHER && pu->file[0] == '/') {
+	    else if ((pu->scheme == SCM_GOPHER
+		      || pu->scheme == SCM_GOPHERS) && pu->file[0] == '/') {
 		p = pu->file;
 		pu->file = allocStr(p + 1, -1);
 	    }
@@ -1228,7 +1236,8 @@ parseURL2(char *url, ParsedURL *pu, Pars
 	}
 	else if (
 #ifdef USE_GOPHER
-		    pu->scheme != SCM_GOPHER &&
+		    (pu->scheme != SCM_GOPHER
+		     && pu->scheme != SCM_GOPHERS) &&
 #endif				/* USE_GOPHER */
 		    pu->file[0] == '/') {
 	    /*
@@ -1264,6 +1273,7 @@ _parsedURL2Str(ParsedURL *pu, int pass,
 #ifdef USE_SSL
 	"https",
 	"gemini",
+	"gophers",
 #endif				/* USE_SSL */
     };
 
@@ -1907,6 +1917,7 @@ openURL(char *url, ParsedURL *pu, Parsed
 	return uf;
 #ifdef USE_GOPHER
     case SCM_GOPHER:
+    case SCM_GOPHERS:
 	p = pu->file;
 	n = 0;
 	while(*p == '/') {
@@ -2453,6 +2464,7 @@ schemeToProxy(int scheme)
 	break;
 #ifdef USE_GOPHER
     case SCM_GOPHER:
+    case SCM_GOPHERS:
 	pu = &GOPHER_proxy_parsed;
 	break;
 #endif

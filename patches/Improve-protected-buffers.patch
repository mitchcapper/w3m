 int
+_check_protection(char **url)
+{
+    char p, q;
+
+    p = **url, q = *(*url + 1);
+
+    switch(p) {
+    case '!':
+	(*url)++;
+	return 1;
+    case '\\':
+	if (q != '!')
+	    break;
+	(*url)++;
+    }
+
+    return 0;
+}

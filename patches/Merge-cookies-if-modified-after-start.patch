From: Rene Kita <mail@rkta.de>
Date: Sun May 19 10:39:43 CEST 2024
Subject: Merge cookies if modified after start
Patch: patches/Merge-cookies-if-modified-after-start.patch

---
 cookie.c |   81 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++--
 cookie.h |    1 
 2 files changed, 80 insertions(+), 2 deletions(-)

--- a/cookie.c
+++ b/cookie.c
@@ -20,8 +20,11 @@
 
 #include <errno.h>
 
+static long long cf_mtime;
 static int is_saved = 1;
 
+static int load_cookies(struct cookie **cookie);
+
 #define contain_no_dots(p, ep) (total_dot_number((p),(ep),1)==0)
 
 static unsigned int
@@ -389,6 +392,7 @@ add_cookie(ParsedURL *pu, Str name, Str
     p->version = version;
     p->portl = portlist;
     p->commentURL = commentURL;
+    p->used = 1;
 
     if (flag & COO_SECURE)
 	p->flag |= COO_SECURE;
@@ -426,8 +430,71 @@ nth_cookie(int n)
     return NULL;
 }
 
-#define str2charp(str) ((str)? (str)->ptr : "")
+static void
+unlink_cookie(struct cookie **list, struct cookie *cookie)
+{
+    struct cookie *c;
+
+    if (cookie == *list)
+	*list = (*list)->next;
+    else
+	for (c = *list; c->next; c = c->next)
+	    if (c->next == cookie) {
+		c->next = cookie->next;
+		break;
+	    }
+}
+
+static int
+sync_cookies(void)
+{
+    struct cookie *ck, *nc, *ncs, *oc;
+    struct stat st;
+
+    if (!First_cookie)
+	return 0;
+
+    if (stat(rcFile(COOKIE_FILE), &st)) {
+	is_saved = 0;
+	if (errno == ENOENT)
+	    return 0;
+	else
+	    goto err;
+    }
+
+    if (cf_mtime == (long long)st.st_mtime)
+	return 0;
 
+    load_cookies(&ncs);
+    if (!ncs) return 0;
+    is_saved = 0;
+
+    for (oc = First_cookie; oc; oc = oc->next){
+	if (!(nc = get_cookie_info(ncs, oc->domain, oc->path, oc->name))) {
+	    if (!oc->used)
+		unlink_cookie(&First_cookie, oc);
+	    continue;
+	}
+
+	if (!(nc->expires > oc->expires))
+	    continue;
+
+	for (ck = First_cookie; ck->next != oc; ck = ck->next) ;
+	ck->next = nc;
+	nc->next = oc->next;
+    }
+
+    for (oc = First_cookie; oc->next; oc = oc->next) ;
+    oc->next = ncs;
+
+    return 0;
+
+err:
+    disp_err_message("Can't sync cookies", FALSE);
+    return 1;
+}
+
+#define str2charp(str) ((str)? (str)->ptr : "")
 void
 save_cookies(void)
 {
@@ -439,6 +506,8 @@ save_cookies(void)
 	return;
 
     check_expired_cookies();
+    sync_cookies();
+
     if (is_saved)
 	return;
 
@@ -465,6 +534,7 @@ save_cookies(void)
     fclose(fp);
     chmod(cookie_file, S_IRUSR | S_IWUSR);
 }
+#undef str2charp
 
 static Str
 readcol(char **p)
@@ -484,11 +554,18 @@ load_cookies(struct cookie **cookie)
     Str line;
     char *str;
     struct cookie *ck, *p;
+    struct stat st;
 
+    *cookie = p = NULL;
     if (!(fp = fopen(rcFile(COOKIE_FILE), "r")))
 	return errno;
 
-    *cookie = p = NULL;
+    if (fstat(fileno(fp), &st) == -1) {
+	fclose(fp);
+	return 1;
+    }
+    cf_mtime = (long long)st.st_mtime;
+
     for (;;) {
 	line = Strfgets(fp);
 
--- a/cookie.h
+++ b/cookie.h
@@ -46,6 +46,7 @@ struct cookie {
     char version;
     char flag;
     struct cookie *next;
+    int used;
 };
 global struct cookie *First_cookie init(NULL);
 

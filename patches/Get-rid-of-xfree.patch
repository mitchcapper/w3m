From: Rene Kita <mail@rkta.de>
Date: Tue Sep 17 18:28:00 CEST 2024
Subject: Get rid of xfree
Patch: patches/Get-rid-of-xfree.patch

---
 file.c    |    6 +++---
 indep.c   |   10 +---------
 indep.h   |    1 -
 istream.c |   10 +++++-----
 4 files changed, 9 insertions(+), 18 deletions(-)

--- a/file.c
+++ b/file.c
@@ -8355,7 +8355,7 @@ save2tmp(URLFile uf, const char *tmpf)
   _end:
     memmove(AbortLoading, env_bak, sizeof(JMP_BUF));
     TRAP_OFF;
-    xfree(buf);
+    free(buf);
     fclose(ff);
     current_content_length = 0;
     return retval;
@@ -8497,7 +8497,7 @@ _MoveFile(const char *path1, const char
 	linelen += count;
 	showProgress(&linelen, &trbyte);
     }
-    xfree(buf);
+    free(buf);
     ISclose(f1);
     if (is_pipe)
 	pclose(f2);
@@ -8867,7 +8867,7 @@ uncompress_stream(URLFile *uf, char **sr
 	    UFclose(uf);
 	    if (f)
 		fclose(f);
-	    xfree(buf);
+	    free(buf);
 	    exit(0);
 	}
 	/* child1 */
--- a/indep.c
+++ b/indep.c
@@ -668,14 +668,6 @@ xrealloc(void *ptr, size_t size)
     return newptr;
 }
 
-/* Define this as a separate function in case the free() has
- * an incompatible prototype. */
-void
-xfree(void *ptr)
-{
-    free(ptr);
-}
-
 void *
 w3m_GC_realloc_atomic(void *ptr, size_t size)
 {
@@ -705,7 +697,7 @@ growbuf_init_without_GC(struct growbuf *
     gb->length = 0;
     gb->area_size = 0;
     gb->realloc_proc = &xrealloc;
-    gb->free_proc = &xfree;
+    gb->free_proc = &free;
 }
 
 void
--- a/indep.h
+++ b/indep.h
@@ -73,7 +73,6 @@ extern Str Str_form_quote(Str x);
 extern const char *shell_quote(const char *str);
 #define xmalloc(s) xrealloc(NULL, s)
 extern void *xrealloc(void *ptr, size_t size);
-extern void xfree(void *ptr);
 extern void *w3m_GC_realloc_atomic(void *ptr, size_t size);
 extern void w3m_GC_free(void *ptr);
 extern void growbuf_init(struct growbuf *gb);
--- a/istream.c
+++ b/istream.c
@@ -191,8 +191,8 @@ ISclose(InputStream stream)
         stream->base.close(stream->base.handle);
         mySignal(SIGINT, prevtrap);
     }
-    xfree(stream->base.stream.buf);
-    xfree(stream);
+    free(stream->base.stream.buf);
+    free(stream);
     return 0;
 }
 
@@ -674,7 +674,7 @@ basic_close(int *handle)
 #else
     close(*handle);
 #endif
-    xfree(handle);
+    free(handle);
     return 0;
 }
 
@@ -707,7 +707,7 @@ ssl_close(struct ssl_handle *handle)
     close(handle->sock);
     if (handle->ssl)
 	SSL_free(handle->ssl);
-    xfree(handle);
+    free(handle);
     return 0;
 }
 
@@ -745,7 +745,7 @@ ens_close(struct ens_handle *handle)
 {
     ISclose(handle->is);
     growbuf_clear(&handle->gb);
-    xfree(handle);
+    free(handle);
     return 0;
 }
 

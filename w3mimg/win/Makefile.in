#
# w3mimg/win/Makefile
#
#
@SET_MAKE@
SHELL=@SHELL@
srcdir = @srcdir@
top_srcdir = @top_srcdir@
VPATH = $(srcdir):.
WARNINGS  = -Wall
WARNINGS += -Werror=vla
CFLAGS=$(WARNINGS) $(OPTS) -I../.. -I$(top_srcdir) -I$(top_srcdir)/lib -I$(top_srcdir) -I$(srcdir) @CFLAGS@ @CPPFLAGS@ @DEFS@ $(IMGCFLAGS)
RM=rm
CC=@CC@
CXX=@CXX@

IMGCFLAGS=@IMGWINCFLAGS@
OBJS=win_w3mimg.@OBJEXT@

all: win_w3mimg.@OBJEXT@

win_w3mimg.@OBJEXT@: win_w3mimg.cpp
	$(CXX) $(CFLAGS) -c $<

clean:
	@-$(RM) -f *.@OBJEXT@
distclean: clean
	-$(RM) -f Makefile

#


